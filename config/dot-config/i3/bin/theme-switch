#!/usr/bin/env bash
# Unified light/dark theme switch for i3 + apps. Bound to $mod+F5 (toggle).
#
# The freedesktop "color-scheme" (prefer-light/prefer-dark) is the shared signal
# that Chromium/Electron apps — Chrome, Cursor, Slack, Obsidian — read via the
# running xdg-desktop-portal, so flipping it switches them with no per-app call.
# i3 and alacritty don't read it, so we swap their theme files explicitly.
#
#   theme-switch [light|dark|toggle]   (default: toggle)
set -uo pipefail

state="${XDG_CACHE_HOME:-$HOME/.cache}/theme-mode"
i3dir="$HOME/.config/i3"
alac="$HOME/.config/alacritty"

mode="${1:-toggle}"
if [ "$mode" = toggle ]; then
    cur="$(cat "$state" 2>/dev/null || echo dark)"
    [ "$cur" = dark ] && mode=light || mode=dark
fi

case "$mode" in
    light) scheme=prefer-light; gtk=Gruvbox-Light; theme=gruvbox_light_hard; i3t=theme-light.conf ;;
    dark)  scheme=prefer-dark;  gtk=Gruvbox-Dark;  theme=gruvbox_dark;       i3t=theme-dark.conf ;;
    *) echo "usage: theme-switch [light|dark|toggle]" >&2; exit 1 ;;
esac

# Fall back to Materia if the gruvbox GTK theme isn't installed yet.
if [ ! -d "$HOME/.themes/$gtk" ] && [ ! -d "/usr/share/themes/$gtk" ]; then
    [ "$mode" = light ] && gtk=Materia-light || gtk=Materia-dark
fi

# 1. Shared signal — Chrome / Cursor / Slack / Obsidian follow this via the portal
gsettings set org.gnome.desktop.interface color-scheme "$scheme"
gsettings set org.gnome.desktop.interface gtk-theme "$gtk"

# 2. alacritty — swap the imported theme, then touch the config to force live reload
ln -sf "themes/themes/$theme.toml" "$alac/active.toml"
touch "$alac/alacritty.toml"

# 3. i3 — swap border/bar colors and reload (seamless, windows survive)
ln -sf "$i3t" "$i3dir/theme.conf"
i3-msg reload >/dev/null 2>&1 || true

# 4. rofi — swap the imported theme (read fresh by rofi on next launch)
ln -sf "rofi-$mode.rasi" "$HOME/.config/rofi/active.rasi"

# 5. Claude Code TUI — flip its theme ("light"/"dark") so markdown stays
# readable. Edit the real file (settings.json is a symlink) and touch only the
# theme value. Claude Code watches the file and applies it live.
# Use the *-ansi themes so Claude Code draws from the terminal's gruvbox
# palette (readable on the gruvbox bg) rather than its own hardcoded colors.
claude_settings="$(readlink -f "$HOME/.claude/settings.json" 2>/dev/null || echo "$HOME/.claude/settings.json")"
[ -f "$claude_settings" ] && sed -i 's/\("theme":[[:space:]]*\)"[a-z-]*"/\1"'"$mode"'-ansi"/' "$claude_settings"

# 6. Tilda — flat GTK keyfile, no live reload (read at startup, rewritten on
# exit). We set scheme/palette_scheme to Custom (0) and write explicit gruvbox
# colors (16-bit, = 8-bit * 257) matching the alacritty theme. Applies on the
# NEXT Tilda launch; a currently-running instance keeps its colors and will
# overwrite its own config on quit — quit it before toggling to make it stick.
if [ "$mode" = light ]; then
    til_back="63993 62965 55255"   # bg #f9f5d7 (gruvbox light hard)
    til_text="15420 14392 13878"   # fg #3c3836
    til_palette="64507, 61937, 51143, 52428, 9252, 7453, 39064, 38807, 6682, 55255, 39321, 8481, 17733, 34181, 34952, 45489, 25186, 34438, 26728, 40349, 27242, 31868, 28527, 25700, 37522, 33667, 29812, 40349, 0, 1542, 31097, 29812, 3598, 46517, 30326, 5140, 1799, 26214, 30840, 36751, 16191, 29041, 16962, 31611, 22616, 15420, 14392, 13878"
else
    til_back="7453 8224 8481"       # bg #1d2021 (gruvbox dark hard)
    til_text="60395 56283 45746"   # fg #ebdbb2
    til_palette="10280, 10280, 10280, 52428, 9252, 7453, 39064, 38807, 6682, 55255, 39321, 8481, 17733, 34181, 34952, 45489, 25186, 34438, 26728, 40349, 27242, 43176, 39321, 33924, 37522, 33667, 29812, 64507, 18761, 13364, 47288, 48059, 9766, 64250, 48573, 12079, 33667, 42405, 39064, 54227, 34438, 39835, 36494, 49344, 31868, 60395, 56283, 45746"
fi
read -r til_br til_bg til_bb <<<"$til_back"
read -r til_tr til_tg til_tb <<<"$til_text"
for tcfg in "$HOME"/.config/tilda/config_*; do
    [ -f "$tcfg" ] || continue
    sed -i \
        -e "s/^scheme=.*/scheme=0/" \
        -e "s/^palette_scheme=.*/palette_scheme=0/" \
        -e "s/^back_red=.*/back_red=$til_br/" \
        -e "s/^back_green=.*/back_green=$til_bg/" \
        -e "s/^back_blue=.*/back_blue=$til_bb/" \
        -e "s/^text_red=.*/text_red=$til_tr/" \
        -e "s/^text_green=.*/text_green=$til_tg/" \
        -e "s/^text_blue=.*/text_blue=$til_tb/" \
        -e "s/^cursor_red=.*/cursor_red=$til_tr/" \
        -e "s/^cursor_green=.*/cursor_green=$til_tg/" \
        -e "s/^cursor_blue=.*/cursor_blue=$til_tb/" \
        -e "s|^palette[[:space:]]*=.*|palette = {$til_palette}|" \
        "$tcfg"
done

echo "$mode" > "$state"
command -v notify-send >/dev/null 2>&1 && notify-send -t 1500 "Theme → $mode" || true
